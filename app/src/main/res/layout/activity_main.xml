<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/kids_background"> <!-- Fondo azul clarito -->

    <!-- ESPACIO PARA UN ICONO DIVERTIDO (Opcional) -->
    <!-- Por ahora usaré un icono por defecto de Android como muestra -->
    <ImageView
        android:id="@+id/imgLogoKids"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@android:drawable/btn_star_big_on"
        app:tint="@color/kids_accent_orange"
        android:layout_marginBottom="20dp"
        android:contentDescription="Estrella divertida" />

    <!-- TÍTULO: Color amable, más grande y centrado -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Sonrisas Felices!"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/kids_primary_text"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- SUBTÍTULO: Texto más simple y amigable -->
    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Ven a jugar y a cuidar tus dientes!"
        android:textSize="18sp"
        android:fontFamily="sans-serif-condensed"
        android:textColor="@color/kids_primary_text"
        android:alpha="0.8"
        android:gravity="center"
        android:layout_marginBottom="50dp" />

    <!-- BOTÓN: Redondeado, color naranja vibrante, texto en mayúsculas -->
    <Button
        android:id="@+id/btnVerServicios"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="¡QUIERO VER MIS DIENTES!"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/boton_redondeado_naranja"
        app:backgroundTint="@null"
        android:elevation="4dp" /> <!-- Sombra suave -->

</LinearLayout>