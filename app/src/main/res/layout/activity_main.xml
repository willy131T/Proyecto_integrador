<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#F8F9FA">

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel de Control Médico"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="40dp"/>

    <!-- 1. Ver Lista de Pacientes (Punto de acceso principal para atender) -->
    <Button
        android:id="@+id/btnVerPacientes"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="VER LISTA DE PACIENTES"
        android:textSize="15sp"
        android:backgroundTint="#20c997"
        android:layout_marginBottom="16dp"/>

    <!-- 2. Control de Inventario -->
    <Button
        android:id="@+id/btnInventario"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="CONTROL DE INVENTARIO"
        android:textSize="15sp"
        android:backgroundTint="#ffc107"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <!-- 3. Registrar Nuevo Doctor -->
    <Button
        android:id="@+id/btnRegistrarDoctor"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="REGISTRAR NUEVO DOCTOR"
        android:textSize="15sp"
        android:backgroundTint="#6c757d"
        android:layout_marginBottom="40dp"/>

    <!-- 4. Cerrar Sesión -->
    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CERRAR SESIÓN"
        android:textColor="#dc3545"
        android:backgroundTint="#FFFFFF"
        style="?android:attr/borderlessButtonStyle"/>

</LinearLayout>