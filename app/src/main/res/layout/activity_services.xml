<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/services_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuestros Servicios"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="16dp" />

        <!-- Servicio 1 -->
        <Button
            android:id="@+id/btnServicio1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="1. Limpieza Dental Ultrasónica"
            android:textAlignment="textStart"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <!-- Servicio 2 -->
        <Button
            android:id="@+id/btnServicio2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="2. Blanqueamiento LED"
            android:textAlignment="textStart"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <!-- Servicio 3 -->
        <Button
            android:id="@+id/btnServicio3"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="3. Ortodoncia (Brackets)"
            android:textAlignment="textStart"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <!-- Servicio 4 -->
        <Button
            android:id="@+id/btnServicio4"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="4. Resinas Estéticas"
            android:textAlignment="textStart"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <!-- Servicio 5 -->
        <Button
            android:id="@+id/btnServicio5"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="5. Extracción y Endodoncia"
            android:textAlignment="textStart"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- Botón para pasar a agendar -->
        <Button
            android:id="@+id/btnIrAgendar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Agendar una Cita"
            android:textSize="18sp"
            android:backgroundTint="#0284C7" />

    </LinearLayout>
</ScrollView>