<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Diagnóstico Clínico"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <!-- Selector de la Cita Correspondiente -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vincular a Cita:"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerCitasPaciente"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Procedimiento realizado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Procedimiento Realizado:"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etProcedimientoClinico"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:hint="Ej. Resina en molar superior, profilaxis..."
            android:background="#FFFFFF"
            android:padding="12dp"
            android:gravity="top"
            android:layout_marginBottom="16dp"/>

        <!-- Medicamentos recetados -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medicamentos Recetados:"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etMedicamentosClinico"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:hint="Ej. Amoxicilina 500mg - Cada 8 hrs por 5 días"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:gravity="top"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnGuardarDiagnosticoFinal"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="GUARDAR DIAGNÓSTICO Y TRATAMIENTO"
            android:textSize="15sp"
            android:backgroundTint="#28a745"/>

    </LinearLayout>
</ScrollView>