<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado con Ícono del Paciente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <!-- Aquí puedes cambiar el @android:drawable/... por tu propia imagen de drawable -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#0284C7" />

            <TextView
                android:id="@+id/tvBienvenidaPaciente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="¡Hola, Paciente!"
                android:textColor="#1E293B"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tarjeta 1: Mis Datos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 Mis Datos Médicos"
                    android:textColor="#0284C7"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvDatosPacienteInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando datos..."
                    android:textColor="#475569"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tarjeta 2: Tratamientos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🦷 Mi Historial Clínico"
                    android:textColor="#10B981"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvTratamientoPacienteInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin tratamientos activos."
                    android:textColor="#475569"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tarjeta 3: Próxima Cita -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Próxima Cita"
                    android:textColor="#F59E0B"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvProximaCitaPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No tienes citas agendadas."
                    android:textColor="#475569"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botones de Acción Estilizados -->
        <Button
            android:id="@+id/btnAgendarCitaPaciente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="AGENDAR NUEVA CITA"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0284C7"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnCerrarSesionPaciente"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Cerrar Sesión"
            android:textSize="16sp"
            android:textColor="#EF4444"
            android:backgroundTint="#00000000"
            style="?android:attr/borderlessButtonStyle"/>

    </LinearLayout>
</ScrollView>