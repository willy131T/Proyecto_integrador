<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#F8F9FA">

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel de Paciente"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido a Consultorio Dental Plaza"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="30dp"/>

    <!-- Botón para Agendar Cita -->
    <Button
        android:id="@+id/btnAgendarCitaPaciente"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="AGENDAR NUEVA CITA"
        android:textSize="15sp"
        android:backgroundTint="#0056b3"
        android:layout_marginBottom="16dp"/>

    <!-- Botón para Ver Citas -->
    <Button
        android:id="@+id/btnVerCitasPaciente"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="MIS CITAS PROGRAMADAS"
        android:textSize="15sp"
        android:backgroundTint="#17a2b8"
        android:layout_marginBottom="30dp"/>

    <!-- Botón para Cerrar Sesión -->
    <Button
        android:id="@+id/btnCerrarSesionPaciente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CERRAR SESIÓN"
        android:textColor="#dc3545"
        android:backgroundTint="#FFFFFF"
        style="?android:attr/borderlessButtonStyle"/>

</LinearLayout>