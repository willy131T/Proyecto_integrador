<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F9FA">

    <!-- Tarjeta de Información del Paciente -->
    <TextView
        android:id="@+id/tvNombreDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del Paciente"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvInfoDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edad, Alergias y Contacto"
        android:textSize="15sp"
        android:textColor="#666666"
        android:layout_marginBottom="24dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginBottom="24dp"/>

    <!-- Opciones exclusivas para este paciente -->
    <Button
        android:id="@+id/btnVerCitasPacienteSeleccionado"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="VER CITAS E HISTORIAL DE ESTE PACIENTE"
        android:textSize="14sp"
        android:backgroundTint="#17a2b8"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnNuevoDiagnostico"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="REGISTRAR NUEVO DIAGNÓSTICO / TRATAMIENTO"
        android:textSize="14sp"
        android:backgroundTint="#28a745"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnAgendarCitaParaEl"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="AGENDAR CITA PARA ESTE PACIENTE"
        android:textSize="14sp"
        android:backgroundTint="#0056b3"/>

</LinearLayout>