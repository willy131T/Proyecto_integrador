<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appointment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agendar Cita Dental"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvServicioSeleccionado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Servicio: General"
        android:textSize="18sp"
        android:textStyle="italic"
        android:textColor="#0284C7"
        android:padding="12dp"
        android:background="#E0F2FE"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etNombrePaciente"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nombre completo del paciente"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etTelefono"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Teléfono de contacto"
        android:inputType="phone"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnConfirmarCita"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Confirmar Cita"
        android:textSize="18sp"
        android:backgroundTint="#16A34A" />

</LinearLayout>