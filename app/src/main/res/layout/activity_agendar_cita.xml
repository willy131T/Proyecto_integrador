<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agendar Nueva Cita"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <!-- Selector de Doctor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona el Doctor:"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerDoctor"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Selector de Fecha Automático -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha de la cita:"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etFechaCita"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Selecciona la fecha"
            android:focusable="false"
            android:clickable="true"
            android:focusableInTouchMode="false"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Hora -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hora (ej. 10:00 AM):"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etHoraCita"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ej. 10:00 AM"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Motivo de la consulta (Spinner) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motivo de la consulta:"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerMotivo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="12dp"/>

        <!-- Campo adicional si selecciona "Otro" -->
        <EditText
            android:id="@+id/etMotivoOtro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Escribe el motivo..."
            android:visibility="gone"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnConfirmarCita"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CONFIRMAR CITA"
            android:textSize="16sp"
            android:backgroundTint="#28a745"/>

    </LinearLayout>
</ScrollView>