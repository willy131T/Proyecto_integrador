<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agendar Nueva Cita"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="24dp"
            android:textAlignment="center"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Doctor -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👨‍⚕️ 1. Selecciona al Especialista:"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinnerDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="20dp"/>

                <!-- Fecha y Hora -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📅 2. Elige la Fecha y Hora:"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/etFechaCita"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:background="#F1F5F9"
                        android:hint="DD/MM/AAAA"
                        android:padding="12dp"
                        android:focusable="false"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/etHoraCita"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:background="#F1F5F9"
                        android:hint="HH:MM"
                        android:padding="12dp"
                        android:focusable="false"
                        android:drawableEnd="@android:drawable/ic_menu_recent_history"/>
                </LinearLayout>

                <!-- Motivo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🦷 3. Motivo de la Consulta:"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinnerMotivo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#F1F5F9"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etMotivoOtro"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#F1F5F9"
                    android:hint="Escribe el motivo..."
                    android:padding="12dp"
                    android:visibility="gone"
                    android:layout_marginBottom="20dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnConfirmarCita"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CONFIRMAR CITA"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#10B981"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>